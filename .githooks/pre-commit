#!/bin/sh
#
# Library pre-commit gate.
#
# This runs independently of Claude, which is the whole point: a checks runner invoked by the
# Librarian cannot detect settings that failed to load *before* the session began, and a hook
# defined inside settings.json cannot validate the file that defines it. A malformed settings file
# has already disabled the permission allowlist and both guard hooks once, silently.
#
# -Fast skips the spawned self-test suites so ordinary commits stay quick. Run the full suite
# before a phase gate:
#     powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/Invoke-LibraryChecks.ps1 -IncludeShared
#
# Installed via:  git config core.hooksPath .githooks
# Invoke-LibraryChecks asserts that installation, so an uninstalled hook fails the full suite.

# THE MACHINE'S OWN DESKPOST STAYS OUT OF THE GATE (PLAN-migrate-to-deskpost-dev.md, Q6). A commit made from a seat
# inherits the seat's LIBRARY_WORKSPACE, LIBRARY_SEAT and LIBRARY_SEAT_CLAIM, and its launcher puts the installed
# program on PATH, where the install fixtures then refuse "already installed". So the three are blanked and every
# PATH entry holding a deskpost shim is dropped, as tools/Test-BuiltRelease.ps1 does, for this run only.
set -f
clean_path=""
old_ifs=$IFS
IFS=:
for entry in $PATH; do
    [ -n "$entry" ] || continue
    [ -f "$entry/deskpost.cmd" ] && continue
    [ -f "$entry/deskpost" ] && continue
    clean_path="${clean_path:+$clean_path:}$entry"
done
IFS=$old_ifs
set +f

# A DOCS-ONLY COMMIT RUNS ONLY THE DOCUMENT CHECKS (S104 row 0b; Eric, 2026-10-08: "do we need this gate?").
# tools/docs-gate.ts decides from the staged paths: 0 is its checks passed, 3 is one failed, 4 is "not docs only".
# Anything else -- node missing, the file missing, a crash -- is never a pass: the full runner below runs, as it
# did before this gate existed. The rule for what counts as a document is in the file's header.
LIBRARY_WORKSPACE= LIBRARY_SEAT= LIBRARY_SEAT_CLAIM= DESKPOST_LAUNCHER_PID= PATH="$clean_path" node tools/docs-gate.ts
docs_status=$?
if [ $docs_status -eq 0 ]; then
    exit 0
fi
if [ $docs_status -eq 3 ]; then
    echo ""
    echo "pre-commit: the docs gate failed. Commit aborted."
    echo "Fix the reported checks, or bypass deliberately with --no-verify if you know why."
    exit 1
fi

# WITHOUT POWERSHELL (Linux; kickoffs/s157 row 7, PLAN-cross-office-build-loop.md step 1.3) a code commit runs the commit
# tier, which needs none: the type check, the claim map, the scans and the sections the change selects. It is the
# builder's evidence there; the integrator's push tier on Windows stays the pass mark. Windows takes the route below.
if ! command -v powershell.exe >/dev/null 2>&1; then
    DESKPOST_GATE_SEAT="${LIBRARY_SEAT:-}" LIBRARY_WORKSPACE= LIBRARY_SEAT= LIBRARY_SEAT_CLAIM= DESKPOST_LAUNCHER_PID= PATH="$clean_path" \
        node tools/gate.ts --tier commit
    if [ $? -ne 0 ]; then
        echo ""
        echo "pre-commit: the commit tier failed. Commit aborted."
        echo "Fix the reported checks, or bypass deliberately with --no-verify if you know why."
        exit 1
    fi
    exit 0
fi

DESKPOST_GATE_SEAT="${LIBRARY_SEAT:-}" LIBRARY_WORKSPACE= LIBRARY_SEAT= LIBRARY_SEAT_CLAIM= DESKPOST_LAUNCHER_PID= PATH="$clean_path" \
    node kernel/test/gate-lock.ts --tier commit -- powershell.exe -NoProfile -ExecutionPolicy Bypass -File "tools/Invoke-LibraryChecks.ps1" -Fast
status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "pre-commit: Library checks failed. Commit aborted."
    echo "Fix the reported checks, or bypass deliberately with --no-verify if you know why."
    exit 1
fi

# C25: ask with DESKPOST_GATE_COMPARE=1 git commit ...; observational, never blocks.
# Off by default per Eric, 2026-10-15: c24 row 3 added 35 min 45 s.
# Git's sh exposes SECONDS from hook startup (docs probe included); elsewhere time is unknown.
if [ "${DESKPOST_GATE_COMPARE:-}" = "1" ]; then
    LIBRARY_WORKSPACE= LIBRARY_SEAT= LIBRARY_SEAT_CLAIM= DESKPOST_LAUNCHER_PID= PATH="$clean_path" \
        node tools/gate.ts --tier commit --compare-with "{\"status\":\"pass\",\"seconds\":${SECONDS:-null},\"checks\":[]}"
    compare_status=$?
    if [ $compare_status -ne 0 ]; then
        echo "WARN: the new gate comparison could not finish (exit $compare_status); the old passing gate still decides."
    fi
fi

exit 0
