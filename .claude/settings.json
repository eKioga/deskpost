            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Remove-NotebookQuarantine.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Remove-SeatArchive.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/New-ShelfBook.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Move-LibraryFolder.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Export-CollectionToVault.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Export-PublicTree.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Export-MirrorOpsRepo.ps1\"*)"
        ],
        "deny": []
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "mcp__basic-memory__.*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/Guard-BasicMemoryRead.ps1"
                        ]
                    }
                ]
            },
            {
                "matcher": "Read|Grep|Glob|Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/Guard-ShelfBookRead.ps1"
                        ]
                    }
                ]
            },
            {
                "matcher": "Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/Guard-ShellShelfRead.ps1"
                        ]
                    },
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/Get-PlaybookContext.ps1"
                        ]
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "mcp__validated-book-reader__discover_book_pages|mcp__validated-book-reader__search_open_books|Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/Add-SearchHitReminder.ps1"
                        ]
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/Get-VirtualDeskContext.ps1"
                        ]
                    }
                ]
            }
        ],
        "PostCompact": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/Restore-CompactedGuidance.ps1"
                        ]
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/Restore-CompactedGuidance.ps1"
                        ]
                    },
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/Get-SeatStartContext.ps1"
                        ]
                    }
                ]
            }
        ],
        "ConfigChange": [
            {
                "matcher": "project_settings|local_settings",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/Guard-SettingsIntegrity.ps1"
                        ]
                    }
                ]
            }
        ]
    }
}
