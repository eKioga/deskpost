            "mcp__validated-book-reader__read_open_project_briefing",
            "mcp__validated-book-reader__discover_book_pages",
            "mcp__validated-book-reader__search_open_books",
            "Bash(echo \"exit:$?\")",
            "Bash(xargs sha256sum)",
            "Read(//tmp/**)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Set-VirtualDesk.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Reset-LocalNotebook.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Publish-BookCopy.ps1\"*)",
