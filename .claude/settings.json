            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Edit-ProjectHub.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Get-DeskOverview.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Get-MeterStatus.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Get-TokenBaseline.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Add-ShelfNote.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Add-ShelfBookPage.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Add-ShelfBookTopic.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Rename-ShelfBook.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Invoke-LibraryChecks.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Test-HubMigrationAcceptance.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/New-HubMigrationSnapshot.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Initialize-CodexLibrary.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Restore-BookSource.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Update-BookManifests.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Update-SharedBookManifests.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Set-TopicOverlap.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Remove-SharedEntry.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Add-CatalogEntry.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Get-WikiMigrationInventory.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Import-ExternalWikiToShelf.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Archive-SharedBook.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Find-ShelfDuplicateTopics.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Search-RawBatch.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Set-RawBatchOwner.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Archive-ShelfBook.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Remove-ShelfBook.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Set-ShelfBookPageStub.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Remove-MemoryProject.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Get-LibraryTriageInventory.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Sync-RawUpstream.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Get-BookCurrency.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Invoke-LibraryTriage.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Start-LibrarySeat.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Retire-Seat.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Set-NotebookTopicOwner.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Start-LibrarySeat.ps1\"*)",
            "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"tools/Retire-Seat.ps1\"*)",
